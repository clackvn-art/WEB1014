 Image Expander"},"erase_clutter":{"headline":"Erase clutter and \u003c0\u003eremove backgrounds\u003c/0\u003e","copy":"Brush over or click on distractions to instantly remove them with Canva Pro's Magic Eraser.","cta":"Try Magic Eraser"},"add_text":{"headline":"Add Text to a Photo \u003c0\u003efor Free\u003c/0\u003e","copy":"Give your snapshots something special! Tell your story and add text to your image using our handy-dandy online text tool.","cta":"Add Text To a Photo"},"add_borders":{"headline":"Add borders to your photos for \u003c0\u003ea striking effect\u003c/0\u003e","copy":"Direct attention to your images using Canva's free photo frames and borders. Add photo borders to images for presentations, social media content, or photo portfolios.","cta":"Add a border to a photo"},"next_level":{"headline":"Take your video to \u003c0\u003ethe next level\u003c/0\u003e","copy":"Create professional videos using Canva's drag-and-drop editor with transitions, animations, designer fonts, audio library, and more.","cta":"Start editing for free"},"trim_and_split":{"headline":"The free video editor for \u003c0\u003eevery creator\u003c/0\u003e","copy":"Drag and drop videos, and easily trim, split, and resize clips, all within one editor.","cta":"Start editing for free"},"text_and_transitions":{"headline":"The free video editor for \u003c0\u003eevery creator\u003c/0\u003e","copy":"Drag and drop videos and easily add text, transitions, graphic elements, and more.","cta":"Start editing for free"},"video_background_remover":{"headline":"Remove the background of any video, in \u003c0\u003ejust one click\u003c/0\u003e","copy":"Video Background Remover allows you to remove the background of any video with just one click—no green screen needed!","cta":"Remove background on a video"},"beat_sync":{"headline":"Sync your soundtrack with \u003c0\u003eBeat Sync\u003c/0\u003e","copy":"Ready to drop the beat? Beat Sync on Canva will automatically match your video footage to your soundtrack so you can showcase peak moments and keep your audience tuned in.","cta":"Get your beats synced"},"automatic_captions":{"headline":"Automatic captions in \u003c0\u003eone click\u003c/0\u003e","copy":"Automatically generate video captions to drive engagement and make your content accessible and stream-ready.","cta":"Try Automatic Captions"},"crop_videos":{"headline":"Crop videos online \u003c0\u003efor free\u003c/0\u003e","copy":"Upload any MP4, MOV, WEBM, or MKV file format and crop your video to the right size and aspect ratio.","cta":"Crop your video"},"convert_video_to_gif":{"headline":"Convert your video to GIF online \u003c0\u003efor free\u003c/0\u003e","copy":"Cut and splice together shareable reaction clips out of your funniest videos for social media. Upload your MP4 and other video files on Canva's video to GIF converter without losing quality.","cta":"Convert video to GIF"},"popular_music":{"headline":"Popular music at \u003c0\u003eyour fingertips\u003c/0\u003e","copy":"Effortlessly add music to your video using Canva. Upload your own tracks or browse through our extensive library of stock audio, sound effects, and popular music.","cta":"Add Music to Videos"},"sound_effects":{"headline":"Level up videos with \u003c0\u003esound effects\u003c/0\u003e","copy":"Enhance any video project by adding exciting sound effects. Use SFX that thrill, energize, soothe, and everything in between.","cta":"Add sound effects"},"video_enhancer":{"headline":"Nail down an aesthetic look with \u003c0\u003eVideo Enhancer\u003c/0\u003e","copy":"Enhance your video clips online and transform them into professional-looking videos within minutes.","cta":"Enhance your video"},"resize_video_for_instagram":{"headline":"Instantly resize your video \u003c0\u003efor Instagram\u003c/0\u003e","copy":"Fit your existing videos to Instagram's aspect ratios. No need to cut corners—keep the important parts in while optimizing them for IG.","cta":"Resize video for Instagram"},"photo_magic_eraser":{"